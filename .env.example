# ========================================================
# Cold-Chain Logistics AI FDE Project Environment Variables
# ========================================================

# 1. Database Configuration (Microsoft SQL Server 2022)
SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_ADMIN_USER=sa
SQL_ADMIN_PASSWORD=FdeEnterprisePass123!
SQL_AGENT_USER=USR_FDE_RO
SQL_AGENT_PASSWORD=AgentPassword2026!

# 2. Vector Store Configuration (Pinecone Serverless)
PINECONE_API_KEY=your_pinecone_api_key_here

# 3. LLM Configuration
# Options: GROQ, OPENAI, DEEPSEEK, GEMINI, OLLAMA
Agent_llm=GROQ

# Groq Settings (when Agent_llm=GROQ)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini API Settings (when Agent_llm=GEMINI)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.8-flash

# OpenAI Settings (when Agent_llm=OPENAI or Embeddings_model=OPENAI)
# OPENAI_API_KEY=your_openai_api_key_here

# DeepSeek Settings (when Agent_llm=DEEPSEEK)
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 4. Embeddings Configuration
# Options: LOCAL (HuggingFace CPU) or OPENAI (Cloud 1536 dim)
Embeddings_model=LOCAL
Local_Embedding_Model=BAAI/bge-m3
